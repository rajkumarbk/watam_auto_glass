<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <record id="view_vehicle_glass_list" model="ir.ui.view">
        <field name="name">vehicle.glass.list</field>
        <field name="model">vehicle.glass</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="action_glass_details" model="ir.actions.act_window">
        <field name="name">Glass Details</field>
        <field name="res_model">vehicle.glass</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
