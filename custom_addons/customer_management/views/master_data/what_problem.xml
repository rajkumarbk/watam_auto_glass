<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <record id="view_what_problem_list" model="ir.ui.view">
        <field name="name">what.problem.list</field>
        <field name="model">what.problem</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="action_problem" model="ir.actions.act_window">
        <field name="name">Problems</field>
        <field name="res_model">what.problem</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
