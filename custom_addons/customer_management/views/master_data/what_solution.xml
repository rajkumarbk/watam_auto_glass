<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_what_solution_list" model="ir.ui.view">
        <field name="name">what.solution.list</field>
        <field name="model">what.solution</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="problem_id" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="action_solution" model="ir.actions.act_window">
        <field name="name">solutions</field>
        <field name="res_model">what.solution</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
