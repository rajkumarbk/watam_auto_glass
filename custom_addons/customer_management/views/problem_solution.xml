<odoo>
    <!-- List View -->
    <record id="view_problem_solution_list" model="ir.ui.view">
        <field name="name">problem.solution.list</field>
        <field name="model">problem.solution</field>
        <field name="arch" type="xml">
            <list decoration-warning="solution != False">
                <field name="date" />
                <field name="branch_id" />
                <field name="employee_id" />
                <field name="vehicle_display" />
                <field name="vehicle_number" />
                <field name="name" />
                <field name="phone" />
                <field name="problem" />
                <field name="solution" />

            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_problem_solution_form" model="ir.ui.view">
        <field name="name">problem.solution.form</field>
        <field name="model">problem.solution</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <label for="vehicle_record_id" />
                            <field name="vehicle_record_id" string="Vehicle Number"
                                options="{'no_create': True, 'no_open': True}"
                                placeholder="Search records here..." />

                            <group invisible="vehicle_record_id == False">
                                <field name="branch_id" readonly="1" />
                                <field name="workplace" placeholder="Select workplace"
                                />
                                <field name="employee_id"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    placeholder="Previous Employee" />
                                <field name="vehicle_brand"
                                    placeholder="Select Vehicle Brand" />
                                <field name="vehicle_model"
                                    domain="[('brand_id', '=', vehicle_brand)]"
                                    placeholder="Select Vehicle Model" />
                                <field name="manufactured_year_id"
                                    placeholder="Select Manufactured Year"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                />
                                <field name="service_type" required="1"
                                />
                                <field name="service_option"
                                    invisible="service_type != 'service'" required="1"
                                />
                                <field name="glass_option"
                                    invisible="service_type != 'glass_sale'" required="1"
                                />
                                <field name="retailer_type"
                                    invisible="glass_option != 'retailer_glass'" required="1"
                                />
                                <field name="glass_destination"
                                    placeholder="Select Glass Destination" />
                                <field name="name" placeholder="Enter Customer's Name"
                                />
                                <field name="phone"
                                    placeholder="Enter Customer's Contact Number"
                                />
                                <field name="service_complexity" required="1"
                                />
                                <field name="vehicle_number" placeholder="Enter Vehicle Number"
                                />
                                <field name="invoice_number" placeholder="Enter Invoice Number"
                                />
                                <field name="problem" placeholder="Select the problem"
                                />
                                <field name="solution" placeholder="Select the Solution"
                                    domain="[('problem_id', '=', problem)]" />
                                <field name="branch_id" readonly="1" class="input-field" />
                                <field name="employee_id"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    placeholder="Current Employee" class="input-field" />
                            </group>
                            <!-- After Work -->
                            <group invisible="status not in ('started','done')">
                                <field name="assistant_staff"
                                    options="{'no_create': True, 'no_create_edit': True}"
                                    placeholder="Select Assistant Staff" class="input-field"
                                    required="status in ['started']" />
                                <field name="photo" widget="capture_image" />
                                <field name="notes" placeholder="Type your notes here..." />
                            </group>
                        </group>
                    </group>

                    <group invisible="vehicle_record_id == False">
                        <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="submitted" />
                    </group>
                </sheet>
            </form>

        </field>
    </record>

    <!-- Action: Problem Order -->
    <record id="action_problem_order" model="ir.actions.act_window">
        <field name="name">Problem Order </field>
        <field name="res_model">problem.solution</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'started')]</field>
    </record>

    <!-- Action: Solved Problems -->
    <record id="action_solved_problems" model="ir.actions.act_window">
        <field name="name">Solved Problems</field>
        <field name="res_model">problem.solution</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_problem_solution_list" />
        <field name="domain">[('status', '=', 'done')]</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>