<odoo>
    <!-- List View -->
    <record id="view_problem_solution_list" model="ir.ui.view">
        <field name="name">problem.solution.list</field>
        <field name="model">problem.solution</field>
        <field name="arch" type="xml">
            <list>
                <field name="datetime"/>
                <field name="branch_id"/>
                <field name="employee_id"/>
                <field name="vehicle_display"/>
                <field name="vehicle_number"/>
                <field name="problem"/>
                <field name="solution"/>

            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_problem_solution_form" model="ir.ui.view">
        <field name="name">problem.solution.form</field>
        <field name="model">problem.solution</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                           <field name="customer_record_id" options="{'no_create': True}" placeholder="Select Invoice"/>
                            <field name="name"/>
                            <field name="phone" />
                            <field name="vehicle_brand" />
                            <field name="vehicle_model" />
                            <field name="manufactured_year_id" />
                            <field name="vehicle_number" options="{'no_create': True}"/>
                            <field name="employee_id" options="{'no_create': True, 'no_create_edit': True}" placeholder="Select Employee"/>
                            <field name="problem" placeholder="Select the problem"/>
                            <field name="solution" placeholder="Select the Solution"/>
                        </group>
                        <group>
                            <field name="datetime" readonly= "1"/>
                            <field name="branch_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action: Active Records -->
    <record id="action_problem_solution" model="ir.actions.act_window">
        <field name="name">Problem and Solution</field>
        <field name="res_model">problem.solution</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
