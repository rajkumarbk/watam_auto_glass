<odoo>
    <!-- List View -->
    <record id="view_problem_solution_list" model="ir.ui.view">
        <field name="name">problem.solution.list</field>
        <field name="model">problem.solution</field>
        <field name="arch" type="xml">
            <list decoration-warning="solution != False">
                <field name="date" />
                <field name="previous_date" />
                <field name="branch_id" />
                <field name="new_branch_id" />
                <field name="employee_id" />
                <field name="vehicle_display" />
                <field name="vehicle_number" />
                <field name="name" />
                <field name="phone" />
                <field name="problem" />
                <field name="solution" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_problem_solution_form" model="ir.ui.view">
        <field name="name">problem.solution.form</field>
        <field name="model">problem.solution</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Hidden fields that should always be saved -->
                    <field name="branch_id" invisible="1" force_save="1" />
                    <field name="previous_date" invisible="1" force_save="1" />
                    <field name="status" invisible="1" />
                    
                    <!-- Vehicle selection first -->
                    <group invisible="status != 'not_started'">
                        <field name="vehicle_record_id" string="Search Record"
                            options="{'no_create': True, 'no_open': True}"
                            placeholder="Type Vehicle number, Invoice number or Phone number to search..." />
                    </group>
                    <group>
                        <!-- Before Work: visible only if vehicle selected and status not started -->
                        <group
                            invisible="vehicle_record_id == False or status not in ('not_started','done')">
                            <field name="branch_id" readonly="1" class="input-field" force_save="1" />
                            <field name="previous_date" readonly="1" class="input-field" force_save="1" />
                            <field name="workplace" placeholder="Select workplace"
                                class="input-field" />
                            <field name="employee_id"
                                options="{'no_create': True, 'no_create_edit': True}"
                                placeholder="Previous Employee" class="input-field" />
                            <field name="vehicle_brand" placeholder="Select Vehicle Brand"
                                class="input-field" />
                            <field name="vehicle_model" domain="[('brand_id','=',vehicle_brand)]"
                                placeholder="Select Vehicle Model" class="input-field" />
                            <field name="manufactured_year_id"
                                options="{'no_create': True, 'no_create_edit': True}"
                                placeholder="Select Manufactured Year" class="input-field" />
                            <field name="service_type" required="1" class="input-field" />
                            <field name="service_option" invisible="service_type != 'service'"
                                required="1" class="input-field" />
                            <field name="glass_option" invisible="service_type != 'glass_sale'"
                                required="1" class="input-field" />
                            <field name="retailer_type" invisible="glass_option != 'retailer_glass'"
                                required="1" class="input-field" />
                            <field name="glass_destination" placeholder="Select Glass Destination"
                                class="input-field" />
                            <field name="name" placeholder="Enter Customer's Name"
                                class="input-field" />
                            <field name="phone" placeholder="Enter Customer's Contact Number"
                                class="input-field" />
                            <field name="service_complexity" required="1" class="input-field" />
                            <field name="vehicle_number" placeholder="Enter Vehicle Number"
                                class="input-field" />
                            <field name="invoice_number" placeholder="Enter Invoice Number"
                                class="input-field" />
                            <field name="new_branch_id" readonly="1" class="input-field" />
                            <field name="new_employee_id"
                                options="{'no_create': True, 'no_create_edit': True}"
                                placeholder="Select Employee" class="input-field" />
                            <field name="problem" placeholder="Select the type of complaint"
                                class="input-field" />
                            <field name="solution" placeholder="Select the Solution"
                                domain="[('problem_id','=',problem)]" class="input-field" />
                        </group>
                    </group>
                    <group>

                        <!-- After Work -->
                        <group invisible="status not in ('started','done')">
                            <field name="assistant_staff"
                                options="{'no_create': True, 'no_create_edit': True}"
                                placeholder="Select Assistant Staff" class="input-field"
                                required="status in ['started']" />
                            <field name="photo" widget="capture_image" />
                            <field name="notes" placeholder="Type your notes here..." />
                        </group>
                    </group>

                    <group>
                        <!-- Submit Buttons -->
                        <button name="action_set_started" string="Submit" type="object"
                            class="btn-primary" invisible="status != 'not_started'" />
                        <button name="action_set_done" string="Submit" type="object"
                            class="btn-success" invisible="status != 'started'" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_problem_solution_search" model="ir.ui.view">
        <field name="name">problem.solution.search</field>
        <field name="model">problem.solution</field>
        <field name="arch" type="xml">
            <search string="Search Problem and Solution">
                <field name="invoice_number"/>
                <field name="vehicle_number"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="branch_id"/>
                <field name="new_branch_id"/>
                <field name="employee_id"/>
                <field name="new_employee_id"/>
                <field name="problem"/>
                <field name="solution"/>
                <field name="date"/>
                <field name="previous_date"/>
                <filter string="Not Started" name="not_started" domain="[('status', '=', 'not_started')]"/>
                <filter string="Started" name="started" domain="[('status', '=', 'started')]"/>
                <filter string="Finished" name="done" domain="[('status', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Previous Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    <filter string="Current Branch" name="group_new_branch" context="{'group_by': 'new_branch_id'}"/>
                    <filter string="Current Date" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Previous Date" name="group_previous_date" context="{'group_by': 'previous_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action: Problem Order -->
    <record id="action_problem_order" model="ir.actions.act_window">
        <field name="name">Complaints Registration</field>
        <field name="res_model">problem.solution</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'started')]</field>
    </record>

    <!-- Action: Solved Problems -->
    <record id="action_solved_problems" model="ir.actions.act_window">
        <field name="name">Completed Complaints</field>
        <field name="res_model">problem.solution</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_problem_solution_list" />
        <field name="domain">[('status', '=', 'done')]</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>