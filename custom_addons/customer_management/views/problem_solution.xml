<odoo>
    <!-- List View -->
    <record id="view_problem_solution_list" model="ir.ui.view">
        <field name="name">problem.solution.list</field>
        <field name="model">problem.solution</field>
        <field name="arch" type="xml">
            <list decoration-warning="solution != False">
                <field name="datetime" />
                <field name="branch_id" />
                <field name="employee_id" />
                <field name="vehicle_display" />
                <field name="vehicle_number" />
                <field name="name" />
                <field name="phone" />
                <field name="problem" />
                <field name="solution" />

            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_problem_solution_form" model="ir.ui.view">
        <field name="name">problem.solution.form</field>
        <field name="model">problem.solution</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <label for="vehicle_record_id"/>
                            <field name="vehicle_record_id" string="Vehicle Number" options="{'no_create': True, 'no_open': True}" placeholder="Search vehicle number here..." class="input-field"/>

                            <group invisible="vehicle_record_id == False">
                                <field name="branch_id" readonly="1" class="input-field"/>
                                <field name="workplace" readonly="1" placeholder="Select workplace" class="input-field"/>
                                <field name="employee_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}" placeholder="Select Employee" class="input-field"/>
                                <field name="vehicle_brand" readonly="1" placeholder="Select Vehicle Brand" class="input-field"/>
                                <field name="vehicle_model" readonly="1" domain="[('brand_id', '=', vehicle_brand)]" placeholder="Select Vehicle Model" class="input-field"/>
                                <field name="manufactured_year_id" readonly="1" placeholder="Select Manufactured Year" options="{'no_create': True, 'no_create_edit': True}" class="input-field"/>
                                <field name="service_type" readonly="1" required="1" class="input-field"/>
                                <field name="service_option" readonly="1" invisible="service_type != 'service'" required="1" class="input-field"/>
                                <field name="glass_option" readonly="1" invisible="service_type != 'glass_sale'" required="1" class="input-field"/>
                                <field name="retailer_type" readonly="1" invisible="glass_option != 'retailer_glass'" required="1" class="input-field"/>
                                <field name="glass_destination" readonly="1" placeholder="Select Glass Destination" class="input-field"/>
                                <field name="name" readonly="1" placeholder="Enter Customer's Name" class="input-field"/>
                                <field name="phone" readonly="1" placeholder="Enter Customer's Contact Number" class="input-field"/>
                                <field name="service_complexity" readonly="1" required="1" class="input-field"/>
                                <field name="vehicle_number" placeholder="Enter Vehicle Number" class="input-field"/>
                                <field name="invoice_number" placeholder="Enter Invoice Number" class="input-field"/>
                                <field name="problem" placeholder="Select the problem" class="input-field"/>
                                <field name="solution" placeholder="Select the Solution" domain="[('problem_id', '=', problem)]" class="input-field"/>
                            </group>
                        </group>

                        <!-- <group invisible="vehicle_record_id == False">
                <field name="datetime" readonly="1"/>
                <field name="branch_id" readonly="1"/>
            </group> -->
                    </group>

                    <group invisible="vehicle_record_id == False">
                        <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="submitted"/>
                    </group>
                </sheet>
            </form>

        </field>
    </record>

    <!-- Action: Active Records -->
    <record id="action_problem_solution" model="ir.actions.act_window">
        <field name="name">Complaints Registration</field>
        <field name="res_model">problem.solution</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>