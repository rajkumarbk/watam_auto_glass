<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_report_wizard_form" model="ir.ui.view">
        <field name="name">employee.report.wizard.form</field>
        <field name="model">employee.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Report">
                <sheet>
                    <group>
                        <group string="Filters">
                            <field name="branch_id" required="1" />
                            <field name="use_date_filter" string="Filter by Date Range" />
                            <field name="date_from" required="use_date_filter"
                                invisible="not use_date_filter" />
                            <field name="date_to" required="use_date_filter"
                                invisible="not use_date_filter" />
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" style="margin: 10px;"
                        invisible="use_date_filter">
                        <strong>Note:</strong> Report will include ALL records from the selected
                        branch (no date filtering). </div>
                </sheet>
                <footer>
                    <button name="action_print_report" string="Generate Report" type="object"
                        class="btn-primary" default_focus="1" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_employee_report_wizard" model="ir.actions.act_window">
        <field name="name">Employee Report</field>
        <field name="res_model">employee.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_customer_record" />
    </record>
</odoo>