<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_evaluation_criteria_list" model="ir.ui.view">
        <field name="name">evaluation.criteria.list</field>
        <field name="model">evaluation.criteria</field>
        <field name="arch" type="xml">
            <list>
                <field name="date" />
                <field name="branch_id" />
                <field name="employee_id" />
                <field name="attendance_punctuality" />
                <field name="work_quality" />
                <field name="customer_interaction" />
                <field name="proactivity_initiative" />
                <field name="uniform_safety" />
                <field name="reporting" />
                <field name="total_score" widget="badge" decoration-success="total_score &gt;= 95"
                    decoration-warning="total_score &gt;= 90 and total_score &lt; 95"
                    decoration-danger="total_score &lt; 90" />
            </list>
        </field>
    </record>

    <record id="view_evaluation_criteria_form" model="ir.ui.view">
        <field name="name">evaluation.criteria.form</field>
        <field name="model">evaluation.criteria</field>
        <field name="arch" type="xml">
            <form string="Evaluation Criteria">
                <sheet>
                    <group>
                        <field name="date" />
                        <field name="branch_id" />
                        <field name="employee_id" placeholder="Select Employee"
                            context="{'search_default_current_company': 1}"
                            options="{'no_create': True, 'no_create_edit': True}" />
                    </group>

                    <notebook>
                        <page string="Evaluation Criteria">
                            <group>
                                <field name="attendance_punctuality" />
                                <field name="work_quality" />
                                <field name="customer_interaction" />
                                <field name="proactivity_initiative" />
                                <field name="uniform_safety" />
                                <field name="reporting" />
                            </group>
                            <style>
                                .o_form_label {
                                white-space: nowrap !important;
                                }
                            </style>
                        </page>
                    </notebook>

                    <group>
                        <field name="total_score" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_evaluation_criteria" model="ir.actions.act_window">
        <field name="name">Employee Evaluation</field>
        <field name="res_model">evaluation.criteria</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>