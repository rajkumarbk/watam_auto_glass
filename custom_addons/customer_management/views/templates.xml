<odoo>
  <data>
    <record id="view_customer_record_list_inherit" model="ir.ui.view">
      <field name="name">customer.record.list.inherit.print.button</field>
      <field name="model">customer.record</field>
      <field name="inherit_id" ref="customer_management.view_customer_record_list" />
      <field name="arch" type="xml">
        <xpath expr="//list" position="inside">
          <header>
            <button name="action_employee_report_wizard"
              string="Print"
              type="object"
              class="btn-primary"
              icon="fa-print"
              display="always" />
          </header>
        </xpath>
      </field>
    </record>
  </data>
</odoo>