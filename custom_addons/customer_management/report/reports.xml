<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_customer_record">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-family: Arial, sans-serif; padding: 30px;">
                    
                    <div class="header" style="text-align: center; margin-bottom: 25px;">
                        <h2 style="border-bottom: 2px solid #333; display: inline-block; padding-bottom: 5px;">
                            Customer Service Record
                        </h2>
                    </div>

                    <table style="width: 100%; border-collapse: collapse; border: 1px solid #444; font-size: 14px;">
                        <tr style="background-color: #f2f2f2;">
                            <td style="width: 30%; border: 1px solid #444; padding: 8px; font-weight: bold;">Invoice:</td>
                            <td style="border: 1px solid #444; padding: 8px;"><span t-field="doc.invoice_number"/></td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #444; padding: 8px; font-weight: bold;">Customer:</td>
                            <td style="border: 1px solid #444; padding: 8px;"><span t-field="doc.name"/></td>
                        </tr>
                        <tr style="background-color: #f9f9f9;">
                            <td style="border: 1px solid #444; padding: 8px; font-weight: bold;">Phone:</td>
                            <td style="border: 1px solid #444; padding: 8px;"><span t-field="doc.phone"/></td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #444; padding: 8px; font-weight: bold;">Vehicle:</td>
                            <td style="border: 1px solid #444; padding: 8px;"><span t-field="doc.vehicle_display"/></td>
                        </tr>
                        <tr style="background-color: #f9f9f9;">
                            <td style="border: 1px solid #444; padding: 8px; font-weight: bold;">Status:</td>
                            <td style="border: 1px solid #444; padding: 8px;"><span t-field="doc.status"/></td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #444; padding: 8px; font-weight: bold;">Type:</td>
                            <td style="border: 1px solid #444; padding: 8px;"><span t-field="doc.service_type"/></td>
                        </tr>
                    </table>

                    <div style="margin-top: 30px; text-align: center; font-size: 12px; color: #666;">
                        <p>Thank you for choosing our service.</p>
                    </div>

                </div>
            </t>
        </t>
    </template>

    <record id="action_report_customer_record" model="ir.actions.report">
        <field name="name">CRM_Report</field>
        <field name="model">customer.record</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customer_management.report_customer_record</field>
        <field name="binding_model_id" ref="customer_management.model_customer_record"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
