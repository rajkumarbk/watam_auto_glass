<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- External Header Layout -->
    <template id="header_external_layout">
        <div class="header" style="font-size: 11px;font-family: Arial !important;">
            <div class="row">
                <div class="col-12">
                    <!-- <img class="img-fluid h-130px"
                    src="/customer_management/static/img/header.png"
                        alt="Logo" /> -->
                </div>
            </div>
        </div>
    </template>

    <!-- External Layout - Simplified without company logic -->
    <template id="external_layout">
        <t t-if="not o" t-set="o" t-value="doc" />

        <t t-call="customer_management.header_external_layout" />
        <div class="article o_report_layout_standard"
            t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
            t-att-data-oe-lang="o and o.env.context.get('lang')">
            <div>
                <t t-out="0" />
            </div>
        </div>
        <t t-call="customer_management.footer_external_layout" />
    </template>

    <template id="footer_external_layout">
        <div class="footer" style="font-size: 12px !important; font-family: Arial!important;">
            <div class="text-center">
                <!-- Footer image -->
                <!-- <img class="img-fluid h-130px"
                    src="/customer_management/static/img/footer.png" alt="Logo" /> -->
            </div>
        </div>
    </template>

    <record id="paperformat_a4_potrait" model="report.paperformat">
        <field name="name">Perfonec Invoice A4</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">40</field>
        <field name="dpi">90</field>
    </record>


</odoo>