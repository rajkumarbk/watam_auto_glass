<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module category -->
    <record id="module_customer_management" model="ir.module.category">
        <field name="name">Customer Management</field>
        <field name="description">Access rights for Customer Management</field>
        <field name="sequence">100</field>
    </record>

    <!-- Supervisor Group -->
    <record id="group_customer_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="category_id" ref="module_customer_management" />
    </record>

    <!-- Admin Group -->
    <record id="group_customer_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="module_customer_management" />
        <field name="implied_ids" eval="[(4, ref('group_customer_supervisor'))]" />
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>

    <!-- Record Rule: Supervisor sees customer records from same company branches -->
    <record id="rule_client_record_company_supervisor" model="ir.rule">
        <field name="name">Client Record: Company Restriction</field>
        <field name="model_id" ref="model_customer_record" />
        <field name="domain_force">[('branch_id','in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_customer_supervisor'))]" />
    </record>

    <!-- Record Rule: Supervisor sees problem solutions from same company branches -->
    <record id="rule_problem_solution_company_supervisor" model="ir.rule">
        <field name="name">Problem Solution: Company Restriction</field>
        <field name="model_id" ref="model_problem_solution" />
        <field name="domain_force">[('branch_id','in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_customer_supervisor'))]" />
    </record>
</odoo>