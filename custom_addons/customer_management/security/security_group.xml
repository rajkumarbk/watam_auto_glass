<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module category -->
    <record id="module_customer_management" model="ir.module.category">
        <field name="name">Customer Management</field>
        <field name="description">Access rights for Customer Management</field>
        <field name="sequence">100</field>
    </record>

    <!-- Supervisor Group -->
    <record id="group_customer_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="category_id" ref="module_customer_management" />
    </record>

    <!-- Admin Group -->
    <record id="group_customer_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="module_customer_management" />
        <field name="users" eval="[(4, ref('base.user_admin'))]" />
    </record>

    <!-- ========== CUSTOMER RECORDS RULES ========== -->

    <!-- Rule for Supervisors ONLY -->
    <record id="rule_client_record_supervisor" model="ir.rule">
        <field name="name">Client Record: Supervisor Access</field>
        <field name="model_id" ref="model_customer_record"/>
        <field name="domain_force">
            ['|',
                '&amp;', ('status', '!=', 'done'), ('branch_id', '=', user.company_id.id),
                '&amp;', ('status', '=', 'done'), ('branch_id', 'in', user.company_id.parent_id.child_ids.ids)
            ]
        </field>
        <field name="groups" eval="[(4, ref('group_customer_supervisor'))]"/>
    </record>

    <!-- Rule for Admins - Full Access -->
    <record id="rule_client_record_admin" model="ir.rule">
        <field name="name">Client Record: Admin Access</field>
        <field name="model_id" ref="model_customer_record"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_customer_admin'))]"/>
    </record>

    <!-- ========== PROBLEM SOLUTIONS RULES ========== -->

    <!-- Rule for Supervisors ONLY -->
    <record id="rule_problem_solution_supervisor" model="ir.rule">
        <field name="name">Problem Solution: Supervisor Access</field>
        <field name="model_id" ref="model_problem_solution"/>
        <field name="domain_force">
            ['|',
                '&amp;', ('status', '!=', 'done'), ('new_branch_id', '=', user.company_id.id),
                '&amp;', ('status', '=', 'done'), ('new_branch_id', 'in', user.company_id.parent_id.child_ids.ids)
            ]
        </field>
        <field name="groups" eval="[(4, ref('group_customer_supervisor'))]"/>
    </record>

    <!-- Rule for Admins - Full Access -->
    <record id="rule_problem_solution_admin" model="ir.rule">
        <field name="name">Problem Solution: Admin Access</field>
        <field name="model_id" ref="model_problem_solution"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_customer_admin'))]"/>
    </record>

    <!-- ========== EVALUATION CRITERIA RULES ========== -->

    <!-- Rule for Supervisors ONLY -->
    <record id="rule_evaluation_criteria_supervisor" model="ir.rule">
        <field name="name">Evaluation Criteria: Supervisor Access</field>
        <field name="model_id" ref="model_evaluation_criteria"/>
        <field name="domain_force">
            [('branch_id', 'in', user.company_ids.ids)]
        </field>
        <field name="groups" eval="[(4, ref('group_customer_supervisor'))]"/>
    </record>

    <!-- Rule for Admins - Full Access -->
    <record id="rule_evaluation_criteria_admin" model="ir.rule">
        <field name="name">Evaluation Criteria: Admin Access</field>
        <field name="model_id" ref="model_evaluation_criteria"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_customer_admin'))]"/>
    </record>

</odoo>