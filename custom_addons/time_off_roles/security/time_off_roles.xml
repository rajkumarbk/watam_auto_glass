<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Time Off module category
        Makes all custom groups appear under a single "Time Off" section
        in Settings → Users & Companies → Groups.
    -->
    <record id="base.module_category_human_resources_time_off" model="ir.module.category">
        <field name="visible" eval="True"/>
    </record>

    <!--
        =====================================================================
        INDEPENDENT ROLE GROUPS
        Each group is fully self-contained — no implied inheritance from
        Odoo's built-in hr_holidays groups.  Access to leave records is
        granted exclusively via ir.model.access.csv entries.

        Approval chains:
          Worker         → submitted → branch_manager → manager → HR ✅
          Branch Manager → manager → HR ✅
          Officer        → manager → HR ✅
          Manager        → manager → ceo → HR ✅
          HR (req)       → manager → ceo → HR ✅
        =====================================================================
    -->

    <!-- EMPLOYEE — base level, can only submit own leaves -->
    <record id="group_timeoff_employee" model="res.groups">
        <field name="name">Time Off: Employee</field>
        <field name="category_id" ref="base.module_category_human_resources_time_off"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- BRANCH MANAGER — approves Worker leaves (submitted → branch_manager) -->
    <record id="group_timeoff_branch_manager" model="res.groups">
        <field name="name">Time Off: Branch Manager</field>
        <field name="category_id" ref="base.module_category_human_resources_time_off"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!--
        OFFICER — can submit own leaves; skips Branch Manager stage.
        Goes directly: Officer (REQ) → Manager (approve) → HR (approve) ✅
        Implies hr_holidays.group_hr_holidays_user so Odoo's native
        leave form is accessible, but does NOT imply Administrator.
    -->
    <record id="group_timeoff_officer" model="res.groups">
        <field name="name">Time Off: Officer</field>
        <field name="category_id" ref="base.module_category_human_resources_time_off"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('hr_holidays.group_hr_holidays_user')),
        ]"/>
    </record>

    <!-- MANAGER — approves Branch Manager stage leaves (branch_manager → manager) -->
    <record id="group_timeoff_manager" model="res.groups">
        <field name="name">Time Off: Manager</field>
        <field name="category_id" ref="base.module_category_human_resources_time_off"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!--
        CEO — approves Manager/HR requester leaves (manager → ceo).
        Does NOT imply Administrator or Officer — CEO is a standalone
        approver role, not an Odoo HR admin.
    -->
    <record id="group_timeoff_ceo" model="res.groups">
        <field name="name">Time Off: CEO</field>
        <field name="category_id" ref="base.module_category_human_resources_time_off"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!--
        HR — gives the final approval on ALL leave requests.
        Must imply hr_holidays.group_hr_holidays_manager so Odoo's native
        action_validate() works (it checks that group internally).
        NOTE: group_hr_holidays_manager itself implies group_hr_holidays_user
        (Officer) in Odoo core — this is why Officer was auto-checking.
        We cannot avoid that native implication, but we isolate it here
        so only HR carries it, not CEO.
    -->
    <record id="group_timeoff_hr" model="res.groups">
        <field name="name">Time Off: HR</field>
        <field name="category_id" ref="base.module_category_human_resources_time_off"/>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('hr_holidays.group_hr_holidays_manager')),
        ]"/>
    </record>
    <data>

        <!--
        Add a record rule to ensure managers can only see officer leave requests
        where they are the respective manager (parent_id)
    -->
        <record id="hr_leave_manager_officer_rule" model="ir.rule">
            <field name="name">Manager: Can only approve their subordinate officer leaves</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="groups" eval="[(4, ref('time_off_roles.group_timeoff_manager'))]"/>
            <field name="domain_force">[
        '|',
          ('requester_role', '!=', 'officer'),
          '&amp;',
            ('requester_role', '=', 'officer'),
            ('employee_id.parent_id.user_id', '=', user.id)
      ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>

</odoo>