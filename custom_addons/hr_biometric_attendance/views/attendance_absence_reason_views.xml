<odoo>
    <record id="view_absence_reason_list" model="ir.ui.view">
        <field name="name">attendance.absence.reason.list</field>
        <field name="model">attendance.absence.reason</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="employee_id" placeholder="All employees"/>
                <field name="date_from" widget="daterange" string="Dates"
                    options="{'end_date_field': 'date_to'}"/>
                <field name="date_to" column_invisible="1"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="view_absence_reason_form" model="ir.ui.view">
        <field name="name">attendance.absence.reason.form</field>
        <field name="model">attendance.absence.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id" placeholder="All employees"/>
                        <field name="date_from" widget="daterange" string="Dates"
                            options="{'end_date_field': 'date_to'}"/>
                        <field name="date_to" invisible="1"/>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_absence_reason_search" model="ir.ui.view">
        <field name="name">attendance.absence.reason.search</field>
        <field name="model">attendance.absence.reason</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="reason"/>
                <filter name="all_employees" string="All Employees"
                        domain="[('employee_id', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_absence_reason" model="ir.actions.act_window">
        <field name="name">Absence Reasons</field>
        <field name="res_model">attendance.absence.reason</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_absence_reason"
        name="Absence Reasons"
        action="action_absence_reason"
        parent="hr_attendance.menu_hr_attendance_root"
        sequence="50"/>
</odoo>