<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_passport_expiry" model="mail.template">
        <field name="name">Passport Expiry Reminder</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="subject">Passport Expiry Reminder</field>
        <field name="email_from">${(user.email or '')}</field>
        <field name="email_to">${object.private_email}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html" type="html">
<![CDATA[
<p>Dear ${object.name},</p>

<p>
    Your passport will expire on
    <strong>${object.passport_expiry}</strong>.
</p>

<p>
    Please renew it before the expiry date.
</p>

<p>Regards,<br/>HR Department</p>
]]>
        </field>
    </record>
</odoo>