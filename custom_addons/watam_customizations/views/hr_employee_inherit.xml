<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='passport_id']" position="after">
                <field name="passport_expiry"/>
            </xpath>
            <xpath expr="//field[@name='birthday']" position="after">
                <field name="birthplace"/>
            </xpath>
            <xpath expr="//field[@name='marital']" position="after">
                <field name="no_of_dependents"/>
            </xpath>
            <xpath expr="//field[@name='work_phone']" position="after">
                <field name="alternative_mobile_number"/>
            </xpath>
            <xpath expr="//field[@name='emergency_phone']" position="before">
                <field name="relationship_type"/>
            </xpath>
            <xpath expr="//field[@name='certificate']" position="before">
                <field name="crn_id"/>
            </xpath>
            <xpath expr="//field[@name='crn_id']" position="after">
                <field name="iban_number"/>
            </xpath>
            <xpath expr="//field[@name='iban_number']" position="after">
                <field name="bank_id"/>
            </xpath>
            <xpath expr="//field[@name='bank_id']" position="after">
                <field name="id_iqama_expiry"/>
            </xpath>
            <xpath expr="//field[@name='id_iqama_expiry']" position="after">
                <field name="profession_in_iqama"/>
            </xpath>
            <xpath expr="//field[@name='has_work_permit']" position="after">
                <field name="id_iqama_name" invisible="1"/>
                <field name="id_iqama" widget="id_iqama_upload" filename="id_iqama_name"/>
            </xpath>
            <xpath expr="//field[@name='id_iqama']" position="after">
                <field name="passport_name" invisible="1"/>
                <field name="passport" widget="passport_upload" filename="passport_name"/>
            </xpath>
            <xpath expr="//field[@name='passport']" position="after">
                <field name="bank_account_name" invisible="1"/>
                <field name="bank_account" widget="bank_account_upload" filename="bank_account_name"/>
            </xpath>
            <xpath expr="//field[@name='bank_account']" position="after">
                <field name="curriculum_vitae_name" invisible="1"/>
                <field name="curriculum_vitae" widget="curriculum_vitae_upload" filename="curriculum_vitae_name"/>
            </xpath>
            <xpath expr="//field[@name='curriculum_vitae']" position="after">
                <field name="signature_name" invisible="1"/>
                <field name="signature" widget="signature_upload" filename="signature_name"/>
            </xpath>
            <xpath expr="//field[@name='signature']" position="after">
                <field name="educational_certificate_name" invisible="1"/>
                <field name="educational_certificate" widget="educational_certificate_upload" filename="educational_certificate_name"/>
            </xpath>
            <xpath expr="//field[@name='educational_certificate']" position="after">
                <field name="driving_license_name" invisible="1"/>
                <field name="driving_license" widget="driving_license_upload" filename="driving_license_name"/>
            </xpath>

