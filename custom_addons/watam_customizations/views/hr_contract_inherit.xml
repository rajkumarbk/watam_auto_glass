<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_contract_form_inherit_custom" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit.custom</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="joined_date"/>
            </xpath>
            <xpath expr="//field[@name='joined_date']" position="after">
                <field name="employee_parent_id"/>
            </xpath>
            <xpath expr="//field[@name='date_end']" position="after">
                <field name="probation_period"/>
                <field name="reason_for_termination" />
            </xpath>
            <xpath expr="//field[@name='contract_type_id']" position="after">
                <field name="contract_duration"/>
                <field name="work_location"/>
                <field name="write_date" string="Last Updated On" readonly="1"/>
            </xpath>
            <!-- <xpath expr="//field[@name='struct_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='structure_type_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath> -->
        </field>
    </record>

</odoo>