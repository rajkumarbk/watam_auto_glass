<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_equipment_record_list" model="ir.ui.view">
        <field name="name">equipment.record.list</field>
        <field name="model">equipment.record</field>
        <field name="arch" type="xml">
            <list string="Equipment Records">
                <field name="employee_id"/>
                <field name="asset_details_ids"/>
                <field name="asset_return_ids"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_record_form" model="ir.ui.view">
        <field name="name">equipment.record.form</field>
        <field name="model">equipment.record</field>
        <field name="arch" type="xml">
            <form string="Equipment Record">

                <sheet>
                    <div class="oe_title">
                        <label for="employee_id" string="Employee"/>
                        <h1>
                            <field name="employee_id" widget="many2one" placeholder="Select Employee" class="oe_inline"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Equipment" name="equipment">
                            <group string="Asset Details">
                                <field name="asset_details_ids" nolabel="1" colspan="2">
                                    <list editable="bottom">
                                        <field name="asset_type" width="120px"/>
                                        <field name="date_received" width="110px"/>
                                        <field name="condition_at_receipt" width="140px"/>
                                        <field name="asset_description" width="200px"/>
                                        <field name="employee_signature_name" column_invisible="1"/>
                                        <field name="employee_signature" filename="employee_signature_name" width="150px"/>
                                        <field name="manager_signature_name" column_invisible="1"/>
                                        <field name="manager_signature" filename="manager_signature_name" width="150px"/>
                                        <field name="notes" width="200px"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Handover and return Details">
                                <field name="asset_return_ids" nolabel="1" colspan="2">
                                    <list editable="bottom">
                                        <field name="expected_return_date" width="140px"/>
                                        <field name="actual_return_date" width="140px"/>
                                        <field name="condition_at_return" width="140px"/>
                                        <field name="employee_signature_name" column_invisible="1"/>
                                        <field name="employee_signature" filename="employee_signature_name" width="150px"/>
                                        <field name="manager_signature_name" column_invisible="1"/>
                                        <field name="manager_signature" filename="manager_signature_name" width="150px"/>
                                        <field name="notes" width="200px"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_equipment_record" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">equipment.record</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_equipment_record_list"/>
    </record>

    <menuitem id="menu_employee_equip" name="Equipment" action="action_equipment_record" groups="hr.group_hr_user" parent="hr.menu_hr_root" sequence="6" />

</odoo>