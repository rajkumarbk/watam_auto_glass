<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Laptop Records List View -->
    <record id="view_laptop_records_list" model="ir.ui.view">
        <field name="name">laptop.records.list</field>
        <field name="model">laptop.records</field>
        <field name="arch" type="xml">
            <list string="Laptop Records">
                <field name="brand"/>
                <field name="model"/>
                <field name="serial_number"/>
                <field name="issue_date"/>
            </list>
        </field>
    </record>

    <!-- Car Records List View -->
    <record id="view_car_records_list" model="ir.ui.view">
        <field name="name">car.records.list</field>
        <field name="model">car.records</field>
        <field name="arch" type="xml">
            <list string="Car Records">
                <field name="brand"/>
                <field name="model"/>
                <field name="plate_number"/>
                <field name="vin_number"/>
                <field name="issue_date"/>
            </list>
        </field>
    </record>
</odoo>