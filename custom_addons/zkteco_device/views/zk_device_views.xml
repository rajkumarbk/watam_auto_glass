<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ZK Device Form View (updated) -->
    <record id="view_zk_device_form" model="ir.ui.view">
        <field name="name">zk.device.form</field>
        <field name="model">zk.device</field>
        <field name="arch" type="xml">
            <form string="ZKTeco Device">
                <header>
                    <button name="test_connection" 
                            string="Test Connection" 
                            type="object" 
                            class="oe_highlight"
                            icon="fa-plug"/>
                    <button name="sync_attendance_data" 
                            string="Sync Attendance" 
                            type="object" 
                            class="oe_highlight"
                            icon="fa-refresh"
                            attrs="{'invisible': [('use_adms', '=', True)]}"/>
                    <field name="is_connected" invisible="1"/>
                </header>
                <sheet>
                    <!-- ... (keep existing) -->
                    <group>
                        <group string="Connection Settings">
                            <field name="use_adms" widget="boolean_toggle"/>
                            <field name="device_ip" placeholder="192.168.1.100"/>
                            <field name="device_port"/>
                            <field name="device_sn" placeholder="Device Serial Number"/>
                            <field name="adms_url" attrs="{'invisible': [('use_adms', '=', False)], 'required': [('use_adms', '=', True)]}"/>
                        </group>
                    </group>
                    <!-- ... (keep notebook with updated help) -->
                    <notebook>
                        <page string="Configuration Help">
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <h4>Connection Modes:</h4>
                                    <ul>
                                        <li><strong>Direct Pull (Local Network):</strong> Uncheck "Use ADMS Push", enter device IP/port.</li>
                                        <li><strong>ADMS Push (Remote/Local):</strong> Check "Use ADMS Push", set ADMS Push URL to your Odoo (e.g., http://188.54.56.104:8089/iclock). Configure device to push to this IP:port.</li>
                                    </ul>
                                    <!-- ... (keep rest) -->
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <!-- ... (keep chatter) -->
            </form>
        </field>
    </record>

    <!-- ... (keep other views) -->

    <!-- Scheduled Action (disable by default for push) -->
    <record id="ir_cron_sync_zk_devices" model="ir.cron">
        <field name="name">ZKTeco: Auto Sync Attendance</field>
        <field name="model_id" ref="model_zk_device"/>
        <field name="state">code</field>
        <field name="code">
for device in model.search([('active', '=', True), ('is_connected', '=', True), ('use_adms', '=', False)]):
    try:
        device.sync_attendance_data()
    except Exception as e:
        continue
        </field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>

</odoo>